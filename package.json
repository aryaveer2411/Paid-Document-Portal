{
  "name": "paid-client-acccess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "stripe:sync": "tsx --env-file-if-exists=.env src/scripts/stripeSync.ts",
    "zoho:retry": "tsx --env-file-if-exists=.env src/scripts/zohoRetry.ts",
    "stripe:reconcile": "tsx --env-file-if-exists=.env src/scripts/stripeReconcile.ts",
    "refund:retry": "tsx --env-file-if-exists=.env src/scripts/refundRetry.ts",
    "postinstall": "prisma generate"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.109.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "stripe": "^23.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
